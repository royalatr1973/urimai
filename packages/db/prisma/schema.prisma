// Urimai data model — Phase 0 scaffold.
//
// Only the Scheme (the versioned rules asset) lives here for now. The rest of the
// core data model are runtime/session shapes, not tables:
//   - Profile  -> session state in Redis (no PII; never persisted in discovery)
//   - Verdict  -> computed by the pure rules engine (Phase 1)
//   - Rule / DocRef -> embedded inside a Scheme (stored as JSON below)
//
// Later phases add their own tables (see PROJECT_BRIEF.md §6):
//   - Phase 6: AuditLog (immutable, every evaluation) and BeneficiaryRecord
//     (encrypted PII, apply-stage only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A scheme's rules — the asset. Stored VERSIONED; thresholds are data, not code.
/// `verified` stays false until a human signs the version off against the GO.
model Scheme {
  id            String   @id @default(cuid())
  key           String // stable scheme identifier, e.g. "tn_old_age_pension"
  version       Int      @default(1)

  name          String // English
  nameTamil     String
  department    String
  benefit       String // e.g. "₹1,000 / month"
  note          String   @default("")
  applyAt       String

  // ALL criteria must pass; ANY exclusion true disqualifies. Documents are shown
  // as pictures. Each is a JSON array of the shared Rule / DocRef shapes.
  criteria      Json
  exclusions    Json
  documents     Json

  effectiveFrom DateTime? // date the GO took effect (null when not yet known)
  source        String // GO number / URL
  verified      Boolean  @default(false) // false until a human signs off

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
  @@map("schemes")
}

/// Immutable audit record — one row per scheme evaluation. Append-only; no PII (inputs are
/// the discovery profile, which carries no identity).
model AuditLog {
  id          String   @id @default(cuid())
  sessionId   String
  channel     String?
  schemeId    String
  ruleVersion Int
  status      String // eligible | need_info | not_eligible
  reasons     Json
  inputs      Json // profile snapshot — NO identity/PII
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("audit_log")
}

/// Apply-stage identity record — the ONLY place PII is collected, stored ENCRYPTED at rest.
model BeneficiaryRecord {
  id         String   @id @default(cuid())
  sessionId  String
  schemeId   String
  ciphertext String // AES-256-GCM encrypted PII payload (iv:tag:data)
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@map("beneficiary_records")
}

// ---------------------------------------------------------------------------
// Madal (letters) — Phase 0 scaffold (LETTERS_BRIEF.md §6).
// LetterType is the versioned, human-verified asset (like Scheme). Drafts and
// approvals are written from Phase 3 onward; PII encryption + the 30-day
// retention sweep over drafts land in Madal Phase 6.
// ---------------------------------------------------------------------------

/// A letter type — the asset. Versioned; legal citations come ONLY from here,
/// never from the model. `verified` stays false until a human reviews the
/// template + references.
model LetterType {
  id              String   @id @default(cuid())
  key             String // stable identifier, e.g. "rti_request", "generic_petition"
  version         Int      @default(1)

  nameTamil       String
  nameEnglish     String
  addresseeHint   String // who this normally goes to; drives the addressee question
  requiredFacts   Json // FactKey[] — gap loop asks these, one at a time
  optionalFacts   Json // FactKey[]
  languageDefault String   @default("ta") // "ta" | "en" | "bilingual"
  legalRefs       Json // [{label, citation, source}] — the ONLY source of citations
  bodyGuidance    String   @default("") // tone/structure notes for the drafting prompt

  source          String   @default("") // where the template/addressee format came from
  verified        Boolean  @default(false) // false until a human signs off

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
  @@map("letter_types")
}

/// A curator-maintained government office — the addressee directory. Versioned and
/// human-verified like schemes/letter types; the ONLY source of To/CC addresses the
/// system may add on its own (never web search at runtime).
model Office {
  id               String   @id @default(cuid())
  key              String // stable office identifier, e.g. "tn_cm_cell"
  version          Int      @default(1)

  designation      String
  designationTamil String
  department       String
  addressLines     Json // string[]
  pincode          String?
  phone            String?
  email            String?
  level            String   @default("state") // state | district | taluk
  district         String?

  handles          Json // letter-type keys this office can receive (To)
  ccFor            Json // letter-type keys this office should be copied on

  source           String // official URL
  verified         Boolean  @default(false)
  notes            String   @default("")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
  @@map("offices")
}

/// A curator-authored grievance category: classification phrases + the competent-
/// authority escalation chain (designations). Versioned + verified like schemes.
model GrievanceCategory {
  id            String   @id @default(cuid())
  key           String // stable category key, e.g. "patta_transfer"
  version       Int      @default(1)

  issueExamples Json // string[] — real-world phrasings
  toDesignation String // competent first-stop officer designation
  cc            Json // string[] — supervisory chain, nearest first
  entitiesRequired Json @default("[]") // string[] — case data the gap loop asks for

  source        String   @default("")
  verified      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([key, version])
  @@index([key])
  @@map("grievance_categories")
}

/// One drafted letter revision. `draft` holds the structured LetterDraft blocks
/// (senderBlock, addresseeBlock, subject, bodyParagraphs, ...). Contains PII —
/// Madal Phase 6 adds encryption at rest + the retention sweep.
model LetterDraft {
  id            String           @id @default(cuid())
  sessionId     String
  letterTypeKey String
  typeVersion   Int
  revision      Int              @default(0)
  language      String // "ta" | "en" | "bilingual"
  draft         Json
  draftHash     String // sha256 of the assembled letter text
  createdAt     DateTime         @default(now())
  approvals     LetterApproval[]

  @@index([sessionId])
  @@map("letter_drafts")
}

/// The user's explicit approval of a draft — no document is ever delivered
/// without one. The approval utterance (their spoken/typed "yes") is logged.
model LetterApproval {
  id                 String      @id @default(cuid())
  sessionId          String
  draftId            String
  draft              LetterDraft @relation(fields: [draftId], references: [id])
  draftHash          String // sha256 of the final text the user approved
  approvalUtterance  String // transcript of the "yes"
  revisions          Int // how many correction loops before approval
  approvedAt         DateTime    @default(now())

  @@index([sessionId])
  @@map("letter_approvals")
}

/// Per-letter user feedback (July 2026) — one row per completed letter. The raw text
/// is what the user said/typed ("how did you feel?"); sentiment/rating are a coarse
/// bucket for aggregation. No PII (no name/address) — just the reaction + letter context.
model LetterFeedback {
  id            String   @id @default(cuid())
  sessionId     String
  letterTypeKey String?
  categoryKey   String?
  revisions     Int      @default(0)
  sentiment     String // "positive" | "neutral" | "negative"
  rating        Int? // 1–5 when the user gave a number
  text          String // the user's verbatim feedback
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sentiment])
  @@map("letter_feedback")
}

/// Human-safety-net escalation ticket. Contact + message are encrypted (PII).
model Escalation {
  id         String    @id @default(cuid())
  fromEnc    String
  textEnc    String
  reason     String
  status     String    @default("pending") // pending | resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("escalations")
}
