{
  "name": "@urimai/docgen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx scripts/golden-pdf.ts"
  },
  "dependencies": {
    "@urimai/types": "workspace:*",
    "docx": "^9.7.1",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "jszip": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
